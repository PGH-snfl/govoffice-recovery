sMargin="false" Header="false" Height="2106" Protect="false" RowAddr="24" RowSpan="1" Width="2515"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="17"/></P></PARALIST></CELL><CELL BorderFill="148" ColAddr="9" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2106" Protect="false" RowAddr="24" RowSpan="1" Width="2515"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="17"/></P></PARALIST></CELL><CELL BorderFill="148" ColAddr="10" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2106" Protect="false" RowAddr="24" RowSpan="1" Width="2515"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="17"/></P></PARALIST></CELL><CELL BorderFill="148" ColAddr="11" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2106" Protect="false" RowAddr="24" RowSpan="1" Width="4842"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="17"/></P></PARALIST></CELL><CELL BorderFill="76" ColAddr="12" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2106" Protect="false" RowAddr="24" RowSpan="1" Width="4830"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="17"/></P></PARALIST></CELL></ROW></TABLE></TEXT><TEXT CharShape="155"><CHAR/></TEXT></P><P ParaShape="423" Style="185"><TEXT CharShape="107"><CHAR> * 사</CHAR></TEXT><TEXT CharShape="96"><CHAR>업별 고유 성과지표(사업화/제품화, 고용창출 포함), 특허 및 학술 성과는 필수작성사항임</CHAR></TEXT><TEXT CharShape="107"/></P><P ParaShape="423" Style="185"><TEXT CharShape="107"><CHAR> * </CHAR></TEXT><TEXT CharShape="98"><CHAR>사업별 고유 성과지표는“[관련자료- 1] 정량적 성과목표의 사업별 성과지표”를 참조하여</CHAR></TEXT><TEXT CharShape="107"><CHAR> 신청 사업의 성과지표로 항목을 작성하고 반영하지 못했다면 그 사유를 제시</CHAR></TEXT></P><P ParaShape="423" Style="185"><TEXT CharShape="107"><CHAR> * </CHAR></TEXT><TEXT CharShape="106"><CHAR>객관적 증빙제시를 통해 평가가 가능한 성과목표가 있는 경우 추가작성 가능하며, 해당항목</CHAR></TEXT><TEXT CharShape="98"><CHAR>에</CHAR></TEXT><TEXT CharShape="107"><CHAR> 대한 목표치가 없을 경우 해당 항목은 삭제 요망</CHAR></TEXT></P><P ParaShape="423" Style="185"><TEXT CharShape="107"><CHAR> * 에너지절감량/온실가스감축량은 산출방법 및 증빙방안, 세부 산출내역을 추가로 기재</CHAR></TEXT></P><P ParaShape="423" Style="185"><TEXT CharShape="107"><CHAR> * 제시한 각 성과목표의 가중치 합이 100%가 되도록 설정</CHAR></TEXT></P><P ParaShape="425" Style="185"><TEXT CharShape="107"><CHAR>  ※ 가중치 설정시 질적지표(사업별 고유 성과지표, 특허 SMRT 점수 등)의 가중치 합이 50%이상이 되도록 구성</CHAR></TEXT></P><P ParaShape="3" Style="15"><TEXT CharShape="38"/></P><P ColumnBreak="false" PageBreak="true" ParaShape="3" Style="15"><TEXT CharShape="38"><CHAR>  (2) 정량적 목표 항목의 평가방법 및 평가환경</CHAR></TEXT></P><P ParaShape="3" Style="15"><TEXT CharShape="38"/></P><P ParaShape="3" Style="0"><TEXT CharShape="107"><CHAR>    ※ 각 평가항목의 평가방법 및 시작품․시제품 측정을 위한 조건/환경에 대하여 기술</CHAR></TEXT></P><P ParaShape="3" Style="0"><TEXT CharShape="107"><TABLE BorderFill="2" CellSpacing="0" ColCount="4" PageBreak="Cell" RepeatHeader="true" RowCount="3"><SHAPEOBJECT InstId="1748167180" Lock="false" NumberingType="Table" ZOrder="117"><SIZE Height="5418" HeightRelTo="Absolute" Protect="false" Width="47625" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="119" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2122" Protect="false" RowAddr="0" RowSpan="1" Width="3699"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="9" Style="173"><TEXT CharShape="17"><CHAR>순번</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="118" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2122" Protect="false" RowAddr="0" RowSpan="1" Width="7661"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="9" Style="173"><TEXT CharShape="17"><CHAR>평가항목</CHAR></TEXT></P><P ParaShape="9" Style="173"><TEXT CharShape="17"><CHAR>(성능지표)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="118" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2122" Protect="false" RowAddr="0" RowSpan="1" Width="19972"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="9" Style="173"><TEXT CharShape="17"><CHAR>평가방법</CHAR></TEXT><TEXT CharShape="35"/></P></PARALIST></CELL><CELL BorderFill="120" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2122" Protect="false" RowAddr="0" RowSpan="1" Width="16293"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="9" Style="173"><TEXT CharShape="17"><CHAR>평가환경</CHAR></TEXT></P></PARALI