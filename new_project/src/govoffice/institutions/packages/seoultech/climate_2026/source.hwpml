eBreak="None" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="1555112032" Lock="false" NumberingType="Table" ZOrder="3"><SIZE Height="10257" HeightRelTo="Absolute" Protect="false" Width="47899" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="22" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2185" Protect="false" RowAddr="0" RowSpan="1" Width="8307"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="23"><CHAR>작성 요령</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="79" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2185" Protect="false" RowAddr="0" RowSpan="1" Width="39592"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="141" Style="0"><TEXT CharShape="22"><CHAR> 연구개발계획서 작성 후 작성 요령 표는 삭제</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="17" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="8072" Protect="false" RowAddr="1" RowSpan="1" Width="47899"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="122" Style="15"><TEXT CharShape="17"><CHAR>◦ 개발내용 항목은 2-2. 및 3-2. 에서 기술한 항목과 일치하게 작성</CHAR></TEXT></P><P ParaShape="122" Style="15"><TEXT CharShape="17"><CHAR>◦ 개발내용은 Bar Chart로 표시</CHAR></TEXT></P><P ParaShape="122" Style="15"><TEXT CharShape="17"><CHAR>◦ 각 내용별 선, 후행 관계를 명확히 표기</CHAR></TEXT></P><P ParaShape="122" Style="15"><TEXT CharShape="17"><CHAR>◦ 1차년도부터 최종년도 까지의 전체 연구개발기간 동안의 추진일정을 작성</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="138" Style="177"><TEXT CharShape="38"><CHAR>3. 연구개발과제의 추진전략ㆍ방법 및 추진체계</CHAR></TEXT></P><P ParaShape="3" Style="177"><TEXT CharShape="38"/></P><P ParaShape="3" Style="177"><TEXT CharShape="38"><CHAR> 3-1. 기술개발 추진방법⋅전략</CHAR></TEXT></P><P ParaShape="372" Style="0"><TEXT CharShape="107"><CHAR>※ 기 보유 기술 활용 및 외부기술 도입 등을 통한 목표달성 기간 단축 및 연구개발비 절감 방안(혁신제품형 연구개발과제 작성 필수)</CHAR></TEXT></P><P ParaShape="14" Style="0"><TEXT CharShape="106"><CHAR>※ AI R&amp;D 과제의 경우 AI 활용 유형별 추가 작성</CHAR></TEXT></P><P ParaShape="16" Style="0"><TEXT CharShape="337"><TABLE BorderFill="2" CellSpacing="0" ColCount="4" PageBreak="Cell" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="1745242075" Lock="false" NumberingType="Table" ZOrder="116"><SIZE Height="8448" HeightRelTo="Absolute" Protect="false" Width="44056" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="1386" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="2" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2697" Protect="false" RowAddr="0" RowSpan="1" Width="6493"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="31" Style="0"><TEXT CharShape="343"><CHAR>AI활용 유형</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="2" ColAddr="1" ColSpan="1" Dirty=