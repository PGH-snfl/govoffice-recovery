></P></PARALIST></CELL><CELL BorderFill="13" ColAddr="1" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3610" Protect="false" RowAddr="5" RowSpan="1" Width="15147"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="64" Style="0"><TEXT CharShape="221"><CHAR>용역을 의뢰하는</CHAR></TEXT></P><P ParaShape="64" Style="0"><TEXT CharShape="221"><CHAR>주관 또는 공동연구개발기관명</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="121" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3610" Protect="false" RowAddr="5" RowSpan="1" Width="7573"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="64" Style="0"><TEXT CharShape="208"><CHAR>업체명</CHAR></TEXT></P><P ParaShape="64" Style="0"><TEXT CharShape="208"><CHAR>(국가)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="41" ColAddr="4" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3610" Protect="false" RowAddr="5" RowSpan="1" Width="15741"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="64" Style="0"><TEXT CharShape="221"><CHAR>미정으로 기재 또는 추후변경가능</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="122" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3610" Protect="false" RowAddr="6" RowSpan="1" Width="9637"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="64" Style="0"><TEXT CharShape="208"><CHAR>용역금액(예정)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="13" ColAddr="1" ColSpan="2" Dirty="fa