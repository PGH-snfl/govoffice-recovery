="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1365" Protect="false" RowAddr="4" RowSpan="1" Width="3691"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="180"><TEXT CharShape="34"/></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="21" Style="173"><TEXT CharShape="34"/></P><P ParaShape="13" Style="173"><TEXT CharShape="38"><TABLE BorderFill="12" CellSpacing="0" ColCount="2" PageBreak="None" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="1555112107" Lock="false" NumberingType="Table" ZOrder="9"><SIZE Height="16354" HeightRelTo="Absolute" Protect="false" Width="47900" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="284" Left="284" Right="284" Top="284"/><ROW><CELL BorderFill="22" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1751" Protect="false" RowAddr="0" RowSpan="1" Width="7651"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="15"><TEXT CharShape="3"><CHAR>작성 요령</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="79" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1751" Protect="false" RowAddr="0" RowSpan="1" Width="40249"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="141" Style="0"><TEXT CharShape="22"><CHAR> 연구개발계획서 작성 후 작성 요령 표는 삭제</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="17" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="14603" Protect="false" RowAddr="1" RowSpan="1" Width="47900"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="233" Style="15"><TEXT CharShape="17"><CHAR>◦ 국가연구개발사업 주요 수행실적은 기업만 작성하며 기업별 작성</CHAR></TEXT></P><P ParaShape="234" Style="15"><TEXT CharShape="17"><CHAR>◦ </CHAR></TEXT><TEXT CharShape="249"><CHAR>동 과제와 직접적으로 관련된 기보유 특허 등 지식재산권 현황에 대해 기재(국가연구개발사업을 수행하지 않고</CHAR></TEXT><TEXT CharShape="17"><CHAR> 자체개발한 특허도 작성 가능)</CHAR></TEXT></P><P ParaShape="235" Style="15"><TEXT CharShape="17"><CHAR>◦ 기술이전 및 사업화 발생 실적은 모든 연구개발기관이 작성하되 비영리기관(대학, 출연연 등)은 동 과제 참여연구원(책임자 포함)의 실적을 작성</CHAR></TEXT></P><P ParaShape="233" Style="15"><TEXT CharShape="17"><CHAR>◦ 국가연구개발사업 수행과제에 대한 사업화 실적</CHAR></TEXT></P><P ParaShape="13" Style="173"><TEXT CharShape="17"><CHAR>    * 1」 기술이전 또는 자기실시 중 해당사항을 기재</CHAR></TEXT></P><P ParaShape="13" Style="173"><TEXT CharShape="17"><CHAR>    * 2」 신제품 개발, 기존 제품 개선, 신공정 개발, 기존 공정 개선 등에서 해당하는 사항을 기재</CHAR></TEXT></P><P ParaShape="13" Style="173"><TEXT CharShape="17"><CHAR>    * 3」 국내 또는 국외 중 해당사항을 기재</CHAR></TEXT></P><P ParaShape="13" Style="173"><TEXT CharShape="17"><CHAR>    ※ 기술이전 및 사업화 실적은 국가연구개발사업 조사ㆍ분석에 등록된 것이어야 함</CHAR></TEXT></P><P ParaShape="233" Style="15"><TEXT CharShape="17"><CHAR>◦ 최근 5년내 동 과제와 직접 관련된 성과를 작성(과제와 무관한 특허는 작성 지양 요망)</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE></TEXT><TEXT CharShape="127"><CHAR>  </CHAR></TEXT><TEXT CharShape="38"><CHAR>5-2. 경제적 성과 창출계획(원천기술형)</CHAR></TEXT><TEXT CharShape="127"><CHAR> </CHAR></TEXT><TEXT CharShape="169"><CHAR>※ 주관/공동연구개발기관 중 기업만 작성</CHAR></TEXT></P><P ParaShape="128" Style="184"><TEXT CharShape="195"/></P><P ParaShape="3" Style="15"><TEXT CharShape="38"><CHAR>   (1) 본 연구개발과제를 통한 생산 계획 </CHAR></TEXT></P><P ParaShape="67" Style="184"><TEXT CharShape="38"><TABLE BorderFill="2" CellSpacing="0" ColCount="5" PageBreak="Cell" RepeatHeader="true" RowCount="10"><SHAPEOBJECT InstId="1632880173" Lock="false" NumberingType="Table" ZOrder="50"><SIZE Height="22809" HeightRelTo="Absolute" Protect="false" Width="47989" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="50" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3148" Protect="false" RowAddr="0" RowSpan="1" Width="14227"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="25" Style="0"><TEXT CharShape="17"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3148" Protect="false" RowAddr="0" RowSpan="1" Width="11254"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="59" Style="0"><TEXT CharShape="17"><CHAR>(            년)</CHAR></TEXT></P><P ParaShape="59" Style="0"><TEXT CharShape="17"><CHAR>개발 종료 후 1년</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3148" Protect="false" RowAddr="0" RowSpan="1" Width="11254"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="59" Style="0"><TEXT CharShape="17">